[Unit]
Description=New DWH application
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=dwhadmin
Group=dwhadmin
WorkingDirectory=/opt/new-dwh
EnvironmentFile=/etc/new-dwh/new-dwh.env
# Match REPORT_EXPORT_DIR and CUSTOM_DATASET_DIR to subdirectories of this path.
StateDirectory=new-dwh
StateDirectoryMode=0700
ExecStart=/opt/new-dwh/bin/app serve
Restart=on-failure
RestartSec=5s
KillSignal=SIGTERM
TimeoutStopSec=60s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
RestrictSUIDSGID=true
UMask=0077
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
