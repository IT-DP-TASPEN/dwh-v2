APP_NAME="Go Admin"
APP_ENV=development
APP_URL=http://localhost:8080
APP_BIND_HOST=127.0.0.1
APP_PORT=8080
APP_SHUTDOWN_TIMEOUT=45s

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=go_admin
DB_USER=root
DB_PASSWORD=

ALLOW_REGISTRATION=false

SESSION_COOKIE_NAME=admin_session
SESSION_LIFETIME=24h
SESSION_REMEMBER_LIFETIME=720h
SESSION_SECURE=false

FINCLOUD_BASE_URL=https://fincloud.example.com/fincloud
FINCLOUD_USERNAME=
FINCLOUD_PASSWORD=
FINCLOUD_LOCATION_ID=
FINCLOUD_ROLE_ID=
FINCLOUD_HTTP_TIMEOUT=30s
FINCLOUD_INSECURE_SKIP_VERIFY=false

# Report Template Engine. Generate once with: openssl rand -base64 32
REPORT_DATASOURCE_MASTER_KEY=
REPORT_EXPORT_DIR=./var/report-exports
REPORT_CONNECT_TIMEOUT=5s
REPORT_INTERACTIVE_TIMEOUT=20s
REPORT_EXPORT_TIMEOUT=30m
REPORT_DOWNLOAD_TIMEOUT=10m
REPORT_INTERACTIVE_MAX_ROWS=10000
REPORT_INTERACTIVE_PAYLOAD_BYTES=8388608
REPORT_DYNAMIC_OPTION_MAX_ROWS=1000
REPORT_DYNAMIC_OPTION_PAYLOAD_BYTES=1048576
REPORT_CELL_PREVIEW_BYTES=16384
REPORT_MYSQL_MAX_PACKET_BYTES=67108864
REPORT_MAX_CONCURRENT_EXPORTS=2
REPORT_EXPORT_RETENTION=24h
REPORT_EXPORT_CLEANUP_INTERVAL=1h
REPORT_EXPORT_HEARTBEAT_INTERVAL=2s
REPORT_EXPORT_STALE_AFTER=30s
REPORT_EXPORT_ORPHAN_GRACE=1h
