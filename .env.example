APP_NAME="Go Admin"
APP_ENV=development
APP_URL=http://localhost:8080
APP_BIND_HOST=127.0.0.1
APP_PORT=8080
APP_SHUTDOWN_TIMEOUT=45s

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=go_admin
DB_USER=root
DB_PASSWORD=

ALLOW_REGISTRATION=false

SESSION_COOKIE_NAME=admin_session
SESSION_LIFETIME=24h
SESSION_REMEMBER_LIFETIME=720h
SESSION_SECURE=false

FINCLOUD_BASE_URL=https://fincloud.example.com/fincloud
FINCLOUD_USERNAME=
FINCLOUD_PASSWORD=
FINCLOUD_LOCATION_ID=
FINCLOUD_ROLE_ID=
FINCLOUD_HTTP_TIMEOUT=30s
FINCLOUD_INSECURE_SKIP_VERIFY=false
